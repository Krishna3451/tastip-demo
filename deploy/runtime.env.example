# Copy this template to a private absolute path OUTSIDE the checkout; chmod 600 it.
# This is a runtime file. Never pass keys as Docker build arguments or NEXT_PUBLIC_.
TASTIP_APP_ORIGIN=https://your-tastip-host.example
# Hosted provider enablement is a separate authenticated application release gate.
TASTIP_ENABLE_HOSTED_PROVIDERS=0
OPENAI_API_KEY=
QLOO_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
TASTIP_DAILY_PROVIDER_LIMIT=100
TASTIP_GLOBAL_PROVIDER_LIMIT=1000

# Optional runtime Google Maps browser key; this value becomes public to eligible
# browser sessions. Configure Google billing, API/referrer restrictions and quotas
# before enabling. It is not an OpenAI/Qloo server key or a Docker build argument.
TASTIP_ENABLE_GOOGLE_MAPS=0
GOOGLE_MAPS_BROWSER_KEY=
