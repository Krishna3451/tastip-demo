{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/.next-e2e",
      "!!**/.next-preview",
      "!!**/.turbo",
      "!!**/next-env.d.ts",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/.playwright-cli",
      "!!**/bun.lock",
      "!!**/tmp"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
