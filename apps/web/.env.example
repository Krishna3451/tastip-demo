# Server-provider credentials below must never enter NEXT_PUBLIC_ variables.
# Never commit .env.local. The separate Maps browser-key exception is documented below.
# Sample trips work without these. Hosted provider access defaults off.
# Opt in only with the exact HTTPS origin, persistent account storage and quotas.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
QLOO_API_KEY=

# Optional Google browser configuration; disabled until explicitly enabled.
# Unlike the server-provider keys above, this dedicated key is intentionally public
# to eligible browser sessions. Restrict it by website referrer + Maps JavaScript API
# in Google Cloud, enable billing and configure Google-side quotas before activation.
# Runtime delivery avoids baking it into the image with NEXT_PUBLIC_ variables.
# TASTIP_ENABLE_GOOGLE_MAPS=1
# GOOGLE_MAPS_BROWSER_KEY=

# Account storage requires a private persistent directory when hosted.
# Defaults to apps/web/.data when running from the web workspace.
# TASTIP_DATA_DIR=/absolute/private/tastip-data
# Exact public HTTPS origin for cookie mutation checks behind a reverse proxy.
# TASTIP_APP_ORIGIN=https://your-tastip-host.example

# Hosted provider access requires a signed-in matching account. See docs/deployment.md.
# TASTIP_ENABLE_HOSTED_PROVIDERS=1
# TASTIP_DAILY_PROVIDER_LIMIT=100
# TASTIP_GLOBAL_PROVIDER_LIMIT=1000
# Optional exact standalone origin behind a trusted proxy; never infer from headers.
# TASTIP_INTERNAL_ORIGIN=https://0.0.0.0:3000
